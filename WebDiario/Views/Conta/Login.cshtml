@model WebDiario.Models.LoginViewModel

@{
    ViewData["Title"] = "Entrar";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card border rounded-4 shadow-sm bg-white p-4 p-md-5">
                <div class="text-center mb-4">
                    <div class="fs-1 mb-2">📖</div>
                    <h3 class="fw-bold text-dark">Acessar Diário</h3>
                    <p class="text-muted small">Digite suas credenciais para continuar.</p>
                </div>

                <form asp-action="Login" method="post">
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Usuario" class="form-label fw-semibold small text-secondary">E-mail</label>
                        <input asp-for="Usuario" class="form-control rounded-3" placeholder="seu@email.com" />
                        <span asp-validation-for="Usuario" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Senha" class="form-label fw-semibold small text-secondary">Senha</label>
                        <input asp-for="Senha" class="form-control rounded-3" placeholder="Sua senha" />
                        <span asp-validation-for="Senha" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input class="form-check-input" type="checkbox" asp-for="LembrarMe" />
                        <label class="form-check-label text-muted small" asp-for="LembrarMe"></label>
                    </div>

                    <button type="submit" class="btn btn-dark rounded-pill w-100 py-2 shadow-sm mb-3">Entrar</button>

                    <div class="text-center">
                        <span class="text-muted small">Ainda não tem conta?</span>
                        <a asp-action="Registrar" class="text-dark fw-semibold small text-decoration-none ms-1">Criar agora</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>