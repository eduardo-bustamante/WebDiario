@{
    ViewData["Title"] = "Criar Conta";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">

            <div class="text-center mb-4">
                <span class="fs-1">📖</span>
                <h2 class="fw-bold text-dark mt-2 mb-1">Abra sua primeira página</h2>
                <p class="text-muted small">Crie um usuário para guardar suas ideias com privacidade.</p>
            </div>

            <div class="card border rounded-4 shadow-sm bg-white p-4 p-md-5">
                <form asp-action="Registrar" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small rounded-3 mb-3"></div>

                    <div class="mb-3">
                        <label for="usuario" class="form-label fw-semibold small text-uppercase text-secondary">Nome de Usuário</label>
                        <input type="text"
                               id="usuario"
                               name="usuario"
                               class="form-control rounded-3 border-light-subtle py-2"
                               placeholder="Ex: marcos, ana_leitora"
                               required
                               autofocus />
                    </div>

                    <div class="mb-3">
                        <label for="password" class="form-label fw-semibold small text-uppercase text-secondary">Senha</label>
                        <input type="password"
                               id="password"
                               name="password"
                               class="form-control rounded-3 border-light-subtle py-2"
                               placeholder="Mínimo 6 caracteres"
                               required />
                    </div>

                    <div class="mb-4">
                        <label for="confirmPassword" class="form-label fw-semibold small text-uppercase text-secondary">Confirmar Senha</label>
                        <input type="password"
                               id="confirmPassword"
                               name="confirmPassword"
                               class="form-control rounded-3 border-light-subtle py-2"
                               placeholder="Repita a senha"
                               required />
                    </div>

                    <button type="submit" class="btn btn-relax-primary w-100 py-2 rounded-pill shadow-sm mb-3">
                        Concluir Cadastro
                    </button>

                    <div class="text-center">
                        <span class="text-muted small">Já possui uma conta?</span>
                        <a asp-action="Login" class="small fw-semibold text-decoration-none" style="color: var(--sage-primary);">
                            Fazer login
                        </a>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}