@model WebDiario.Models.Livro

@{
    ViewData["Title"] = "Editar Livro";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <a asp-action="Index" class="btn btn-link text-muted text-decoration-none mb-3 ps-0">
                ← Voltar para a estante
            </a>

            <div class="card border rounded-4 shadow-sm bg-white p-4 p-md-5">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h2 class="fw-bold text-dark mb-1">Editar Livro</h2>
                        <p class="text-muted small mb-0">Atualize o progresso da sua leitura ou informações do livro.</p>
                    </div>
                    <span class="badge bg-light text-secondary border px-3 py-2 rounded-pill">Edição</span>
                </div>

                <form asp-action="Editar" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="DataCadastro" />

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <!-- Título e Autor -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-7">
                            <label asp-for="Titulo" class="form-label fw-semibold small text-uppercase text-secondary">Título *</label>
                            <input asp-for="Titulo" class="form-control rounded-3 border-light-subtle" />
                            <span asp-validation-for="Titulo" class="text-danger small"></span>
                        </div>
                        <div class="col-md-5">
                            <label asp-for="Autor" class="form-label fw-semibold small text-uppercase text-secondary">Autor</label>
                            <input asp-for="Autor" class="form-control rounded-3 border-light-subtle" />
                            <span asp-validation-for="Autor" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Gênero, Status e Avaliação -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="Categoria" class="form-label fw-semibold small text-uppercase text-secondary">Gênero / Categoria</label>
                            <input asp-for="Categoria" class="form-control rounded-3 border-light-subtle" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Status" class="form-label fw-semibold small text-uppercase text-secondary">Status de Leitura</label>
                            <select asp-for="Status" class="form-select rounded-3 border-light-subtle">
                                <option value="Quero Ler">Quero Ler</option>
                                <option value="Lendo">Lendo</option>
                                <option value="Lido">Lido</option>
                                <option value="Abandonado">Abandonado</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Avaliacao" class="form-label fw-semibold small text-uppercase text-secondary">Avaliação (1 a 5)</label>
                            <select asp-for="Avaliacao" class="form-select rounded-3 border-light-subtle">
                                <option value="">Sem avaliação</option>
                                <option value="5">★★★★★ (5)</option>
                                <option value="4">★★★★☆ (4)</option>
                                <option value="3">★★★☆☆ (3)</option>
                                <option value="2">★★☆☆☆ (2)</option>
                                <option value="1">★☆☆☆☆ (1)</option>
                            </select>
                        </div>
                    </div>

                    <!-- Páginas -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="PaginasLidas" class="form-label fw-semibold small text-uppercase text-secondary">Páginas Lidas</label>
                            <input asp-for="PaginasLidas" type="number" min="0" class="form-control rounded-3 border-light-subtle" />
                            <span asp-validation-for="PaginasLidas" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="TotalPaginas" class="form-label fw-semibold small text-uppercase text-secondary">Total de Páginas</label>
                            <input asp-for="TotalPaginas" type="number" min="0" class="form-control rounded-3 border-light-subtle" />
                            <span asp-validation-for="TotalPaginas" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Gerenciar Capa -->
                    <div class="card bg-light border-0 rounded-3 p-3 mb-4">
                        <label class="form-label fw-semibold small text-uppercase text-secondary mb-2">Capa do Livro</label>

                        @if (!string.IsNullOrEmpty(Model.FotoCapa))
                        {
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <img src="@Model.FotoCapa" alt="Capa Atual" class="rounded border bg-white" style="width: 50px; height: 75px; object-fit: cover;" />
                                <div>
                                    <div class="small fw-semibold">Capa atual cadastrada</div>
                                    <div class="form-check mt-1">
                                        <input class="form-check-input" type="checkbox" id="removerCapa" name="removerCapa" value="true">
                                        <label class="form-check-label extra-small text-danger" for="removerCapa">
                                            Remover capa atual
                                        </label>
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="small text-muted mb-1">Substituir por arquivo:</label>
                                <input type="file" name="arquivoCapa" class="form-control form-control-sm rounded-3 bg-white" accept="image/png, image/jpeg, image/webp, image/*" />
                            </div>
                            <div class="col-md-6">
                                <label class="small text-muted mb-1">Ou nova URL:</label>
                                <input type="url" name="urlCapa" value="@Model.FotoCapa" class="form-control form-control-sm rounded-3 bg-white" placeholder="https://exemplo.com/imagem.png" />
                            </div>
                        </div>
                    </div>

                    <!-- Notas / Resenha -->
                    <div class="mb-4">
                        <label asp-for="Notas" class="form-label fw-semibold small text-uppercase text-secondary">Notas e Resenha</label>
                        <textarea asp-for="Notas" rows="4" class="form-control rounded-3 border-light-subtle"></textarea>
                    </div>

                    <!-- Botões de Ação -->
                    <div class="d-flex justify-content-end align-items-center gap-3 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light rounded-pill px-4">Cancelar</a>
                        <button type="submit" class="btn btn-dark rounded-pill px-5 shadow-sm">Salvar Alterações</button>
                    </div>

                </form>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}