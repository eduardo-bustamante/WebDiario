@model WebDiario.Models.Livro

@{
    ViewData["Title"] = "Editar Livro";
    var temCapaCadastrada = !string.IsNullOrEmpty(Model.FotoCapa);
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            
            <a asp-action="Index" class="btn btn-link text-muted text-decoration-none mb-3 ps-0">
                ← Voltar para a estante
            </a>

            <div class="card border rounded-4 shadow-sm bg-white p-4 p-md-5">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h2 class="fw-bold text-dark mb-1">Editar Livro</h2>
                        <p class="text-muted small mb-0">Atualize o progresso da leitura, capa ou detalhes da obra.</p>
                    </div>
                    <span class="badge bg-light text-secondary border px-3 py-2 rounded-pill">Edição</span>
                </div>

                <form asp-action="Editar" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="DataCadastro" />
                    <input type="hidden" asp-for="UsuarioId" />

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <!-- Título e Autor -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-7">
                            <label asp-for="Titulo" class="form-label fw-semibold small text-uppercase text-secondary">Título *</label>
                            <input asp-for="Titulo" class="form-control rounded-3 border-light-subtle" required />
                            <span asp-validation-for="Titulo" class="text-danger small"></span>
                        </div>
                        <div class="col-md-5">
                            <label asp-for="Autor" class="form-label fw-semibold small text-uppercase text-secondary">Autor</label>
                            <input asp-for="Autor" class="form-control rounded-3 border-light-subtle" />
                            <span asp-validation-for="Autor" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Categoria, Status e Avaliação -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="Categoria" class="form-label fw-semibold small text-uppercase text-secondary">Gênero / Categoria</label>
                            <input asp-for="Categoria" class="form-control rounded-3 border-light-subtle" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Status" class="form-label fw-semibold small text-uppercase text-secondary">Status</label>
                            <select asp-for="Status" class="form-select rounded-3 border-light-subtle">
                                <option value="Quero Ler">📌 Quero Ler</option>
                                <option value="Lendo">📖 Lendo</option>
                                <option value="Lido">✅ Lido</option>
                                <option value="Abandonado">⏹ Abandonado</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Avaliacao" class="form-label fw-semibold small text-uppercase text-secondary">Avaliação</label>
                            <select asp-for="Avaliacao" class="form-select rounded-3 border-light-subtle">
                                <option value="">Sem avaliação</option>
                                <option value="5">★★★★★ (5)</option>
                                <option value="4">★★★★☆ (4)</option>
                                <option value="3">★★★☆☆ (3)</option>
                                <option value="2">★★☆☆☆ (2)</option>
                                <option value="1">★☆☆☆☆ (1)</option>
                            </select>
                        </div>
                    </div>

                    <!-- Páginas -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="PaginasLidas" class="form-label fw-semibold small text-uppercase text-secondary">Páginas Lidas</label>
                            <input asp-for="PaginasLidas" type="number" min="0" class="form-control rounded-3 border-light-subtle" />
                            <span asp-validation-for="PaginasLidas" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="TotalPaginas" class="form-label fw-semibold small text-uppercase text-secondary">Total de Páginas</label>
                            <input asp-for="TotalPaginas" type="number" min="0" class="form-control rounded-3 border-light-subtle" />
                            <span asp-validation-for="TotalPaginas" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Gestão e Preview de Capa -->
                    <div class="card bg-light border-0 rounded-3 p-3 mb-4">
                        <label class="form-label fw-semibold small text-uppercase text-secondary mb-2">Capa do Livro</label>
                        
                        <div class="row align-items-center g-3">
                            <!-- Preview Atual ou Novo -->
                            <div class="col-auto text-center">
                                <div id="containerPreview" class="rounded-3 border bg-white d-flex align-items-center justify-content-center overflow-hidden" 
                                     style="width: 75px; height: 105px;">
                                    <span id="iconeSemPreview" class="text-muted @(temCapaCadastrada ? "d-none" : "")" style="font-size: 1.8rem;">📖</span>
                                    <img id="imgPreview" 
                                         src="@(temCapaCadastrada ? Model.FotoCapa : "#")" 
                                         alt="Capa" 
                                         class="@(temCapaCadastrada ? "" : "d-none") w-100 h-100" 
                                         style="object-fit: cover;" />
                                </div>
                            </div>

                            <!-- Controles de Substituição / Remoção -->
                            <div class="col">
                                @if (temCapaCadastrada)
                                {
                                    <div class="form-check mb-2">
                                        <input class="form-check-input" type="checkbox" id="removerCapa" name="removerCapa" value="true">
                                        <label class="form-check-label extra-small text-danger fw-semibold" for="removerCapa">
                                            Remover capa atual
                                        </label>
                                    </div>
                                }

                                <div class="mb-2">
                                    <label class="extra-small text-muted mb-1 d-block">Substituir por arquivo local (PNG, JPG, WEBP):</label>
                                    <input type="file" 
                                           name="arquivoCapa" 
                                           id="campoArquivo" 
                                           class="form-control form-control-sm rounded-3 bg-white" 
                                           accept="image/png, image/jpeg, image/webp, image/*" />
                                </div>
                                <div>
                                    <label class="extra-small text-muted mb-1 d-block">Ou atualizar com link externo:</label>
                                    <input type="url" 
                                           name="urlCapa" 
                                           id="campoUrl" 
                                           value="@(!string.IsNullOrEmpty(Model.FotoCapa) && Model.FotoCapa.StartsWith("http") ? Model.FotoCapa : "")"
                                           class="form-control form-control-sm rounded-3 bg-white" 
                                           placeholder="https://exemplo.com/capa.png" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Notas / Resenha -->
                    <div class="mb-4">
                        <label asp-for="Notas" class="form-label fw-semibold small text-uppercase text-secondary">Anotações / Resenha</label>
                        <textarea asp-for="Notas" rows="4" class="form-control rounded-3 border-light-subtle"></textarea>
                    </div>

                    <!-- Botões de Ação -->
                    <div class="d-flex justify-content-end align-items-center gap-3 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light rounded-pill px-4">Cancelar</a>
                        <button type="submit" class="btn btn-dark rounded-pill px-5 shadow-sm">Salvar Alterações</button>
                    </div>

                </form>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const campoArquivo = document.getElementById('campoArquivo');
        const campoUrl = document.getElementById('campoUrl');
        const checkRemover = document.getElementById('removerCapa');
        const imgPreview = document.getElementById('imgPreview');
        const iconeSemPreview = document.getElementById('iconeSemPreview');
        const capaOriginal = '@(Model.FotoCapa ?? "")';

        function definirPreview(url) {
            if (url) {
                imgPreview.src = url;
                imgPreview.classList.remove('d-none');
                iconeSemPreview.classList.add('d-none');
            } else {
                imgPreview.src = '#';
                imgPreview.classList.add('d-none');
                iconeSemPreview.classList.remove('d-none');
            }
        }

        campoArquivo?.addEventListener('change', function () {
            const arquivo = this.files[0];
            if (arquivo) {
                if (campoUrl) campoUrl.value = '';
                if (checkRemover) checkRemover.checked = false;
                const leitor = new FileReader();
                leitor.onload = function (e) {
                    definirPreview(e.target.result);
                };
                leitor.readAsDataURL(arquivo);
            } else {
                definirPreview(capaOriginal || null);
            }
        });

        campoUrl?.addEventListener('input', function () {
            const url = this.value.trim();
            if (url) {
                if (campoArquivo) campoArquivo.value = '';
                if (checkRemover) checkRemover.checked = false;
                definirPreview(url);
            } else {
                definirPreview(capaOriginal || null);
            }
        });

        checkRemover?.addEventListener('change', function () {
            if (this.checked) {
                if (campoArquivo) campoArquivo.value = '';
                if (campoUrl) campoUrl.value = '';
                definirPreview(null);
            } else {
                definirPreview(capaOriginal || null);
            }
        });
        // Sincronização automática do Status pelas páginas digitadas
const inputPaginasLidas = document.querySelector('input[name="PaginasLidas"]');
const inputTotalPaginas = document.querySelector('input[name="TotalPaginas"]');
const selectStatus = document.querySelector('select[name="Status"]');

function sincronizarStatusPorPaginas() {
    if (!inputPaginasLidas || !inputTotalPaginas || !selectStatus) return;

    const lidas = parseInt(inputPaginasLidas.value, 10) || 0;
    const total = parseInt(inputTotalPaginas.value, 10) || 0;

    // Se completou todas as páginas
    if (total > 0 && lidas >= total) {
        selectStatus.value = 'Lido';
    } 
    // Se começou a ler mas ainda não terminou
    else if (lidas > 0 && (selectStatus.value === 'Quero Ler' || lidas < total)) {
        selectStatus.value = 'Lendo';
    }
    // Se zerou as páginas e estava como Lido/Lendo, volta para Quero Ler
    else if (lidas === 0 && selectStatus.value === 'Lendo') {
        selectStatus.value = 'Quero Ler';
    }
}

inputPaginasLidas?.addEventListener('input', sincronizarStatusPorPaginas);
inputTotalPaginas?.addEventListener('input', sincronizarStatusPorPaginas);
    </script>
}