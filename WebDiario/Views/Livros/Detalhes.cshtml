@model WebDiario.Models.Livro

@{
    ViewData["Title"] = Model.Titulo;

    var corStatus = Model.Status switch
    {
        "Lendo" => "bg-primary-subtle text-primary border border-primary-subtle",
        "Lido" => "bg-success-subtle text-success border border-success-subtle",
        "Quero Ler" => "bg-secondary-subtle text-secondary border border-secondary-subtle",
        "Abandonado" => "bg-danger-subtle text-danger border border-danger-subtle",
        _ => "bg-light text-dark"
    };
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <!-- Barra Superior com Ações -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <a asp-action="Index" class="btn btn-link text-muted text-decoration-none ps-0">
                    ← Voltar para a estante
                </a>
                <div class="d-flex gap-2">
                    <a asp-action="Editar" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                        Editar
                    </a>
                    <form asp-action="Excluir" asp-route-id="@Model.Id" method="post" class="d-inline" onsubmit="return confirm('Deseja excluir este livro da estante?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                            Excluir
                        </button>
                    </form>
                </div>
            </div>

            <!-- Card Principal -->
            <div class="card border rounded-4 shadow-sm bg-white p-4 p-md-5">
                <div class="row g-4 mb-4">

                    <!-- Capa -->
                    <div class="col-sm-4 text-center">
                        @if (!string.IsNullOrEmpty(Model.FotoCapa))
                        {
                            <img src="@Model.FotoCapa"
                                 alt="Capa de @Model.Titulo"
                                 class="img-fluid rounded-3 shadow border bg-white"
                                 style="max-height: 250px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="rounded-3 bg-light border d-flex align-items-center justify-content-center text-muted shadow-sm mx-auto"
                                 style="width: 150px; height: 210px; font-size: 3rem;">
                                📖
                            </div>
                        }
                    </div>

                    <!-- Dados Principais -->
                    <div class="col-sm-8">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge rounded-pill px-3 py-1 extra-small fw-semibold @corStatus">
                                @Model.Status
                            </span>
                            @if (Model.Avaliacao.HasValue)
                            {
                                <span class="text-warning fw-bold fs-6">
                                    @string.Concat(Enumerable.Repeat("★", Model.Avaliacao.Value))
                                </span>
                            }
                        </div>

                        <h2 class="h3 fw-bold text-dark mb-1">@Model.Titulo</h2>
                        <p class="text-muted fs-6 mb-3">@(string.IsNullOrEmpty(Model.Autor) ? "Autor não informado" : Model.Autor)</p>

                        @if (!string.IsNullOrEmpty(Model.Categoria))
                        {
                            <span class="badge bg-light text-secondary border mb-3">
                                @Model.Categoria
                            </span>
                        }

                        <!-- Progresso -->
                        <div class="card bg-light border-0 rounded-3 p-3 mt-2">
                            <div class="d-flex justify-content-between align-items-center extra-small mb-1">
                                <span class="text-muted fw-semibold">Progresso da Leitura</span>
                                <span class="fw-bold text-dark">@Model.PercentualLido%</span>
                            </div>
                            <div class="progress mb-2" style="height: 8px;">
                                <div class="progress-bar bg-primary rounded-pill"
                                     role="progressbar"
                                     style="width: @Model.PercentualLido%;"
                                     aria-valuenow="@Model.PercentualLido"
                                     aria-valuemin="0"
                                     aria-valuemax="100"></div>
                            </div>
                            @if (Model.TotalPaginas > 0)
                            {
                                <div class="text-muted extra-small text-end">
                                    @Model.PaginasLidas de @Model.TotalPaginas páginas lidas
                                </div>
                            }
                        </div>
                    </div>

                </div>

                <!-- Resenha e Notas -->
                @if (!string.IsNullOrEmpty(Model.Notas))
                {
                    <div class="pt-4 border-top">
                        <h5 class="fw-bold text-dark mb-2">Notas & Resenha Pessoal</h5>
                        <div class="text-secondary lh-base" style="white-space: pre-line;">
                            @Model.Notas
                        </div>
                    </div>
                }

                <div class="pt-3 border-top text-muted extra-small text-end mt-4">
                    Cadastrado em @Model.DataCadastro.ToString("dd/MM/yyyy")
                </div>
            </div>

        </div>
    </div>
</div>