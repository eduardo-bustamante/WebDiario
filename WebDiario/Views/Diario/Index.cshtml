@model IEnumerable<WebDiario.Models.Diario>

@{
    ViewData["Title"] = "Meu Diário";
    var busca = ViewData["BuscaAtual"] as string;
    var humorAtual = ViewData["HumorAtual"] as int?;
    bool temFiltroAtivo = !string.IsNullOrEmpty(busca) || humorAtual.HasValue;
}

<div class="container py-4">
    <!-- Cabeçalho -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center pb-3 mb-4 border-bottom gap-3">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">📖 Diário & Reflexões</h1>
            <p class="text-muted small mb-0">
                @if (temFiltroAtivo)
                {
                    <span>Filtrando <strong>@Model.Count()</strong> anotações encontradas</span>
                }
                else
                {
                    <span>Total de <strong>@Model.Count()</strong> @(Model.Count() == 1 ? "registro guardado" : "registros guardados")</span>
                }
            </p>
        </div>
        <a asp-action="Criar" class="btn btn-relax-primary px-4 shadow-sm">+ Escrever Agora</a>
    </div>

    <!-- Barra de Pesquisa e Filtros -->
    <div class="card border rounded-4 shadow-sm bg-white p-3 mb-4">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">

            <div class="col-md-7">
                <div class="input-group">
                    <span class="input-group-text bg-light border-light-subtle rounded-start-pill text-muted">🔍</span>
                    <input type="text"
                           name="busca"
                           value="@busca"
                           class="form-control border-light-subtle rounded-end-pill"
                           placeholder="Pesquisar memórias, pensamentos..." />
                </div>
            </div>

            <div class="col-md-3">
                <select name="humor" class="form-select border-light-subtle rounded-pill">
                    <option value="">Todos os Humores</option>
                    <option value="5" selected="@(humorAtual == 5)">🤩 Excelente (Nível 5)</option>
                    <option value="4" selected="@(humorAtual == 4)">🙂 Bem (Nível 4)</option>
                    <option value="3" selected="@(humorAtual == 3)">😐 Neutro (Nível 3)</option>
                    <option value="2" selected="@(humorAtual == 2)">🙁 Para Baixo (Nível 2)</option>
                    <option value="1" selected="@(humorAtual == 1)">😫 Muito Difícil (Nível 1)</option>
                </select>
            </div>

            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-dark rounded-pill w-100">Filtrar</button>
                @if (temFiltroAtivo)
                {
                    <a asp-action="Index" class="btn btn-light border rounded-pill" title="Limpar Filtros">✕</a>
                }
            </div>

        </form>
    </div>

    <!-- Lista de Entradas -->
    @if (!Model.Any())
    {
        <div class="text-center py-5 my-4 bg-white rounded-4 border p-5 shadow-sm">
            @if (temFiltroAtivo)
            {
                <div class="display-4 mb-3">🔍</div>
                <h4 class="fw-semibold text-dark">Nenhuma anotação encontrada</h4>
                <p class="text-muted mx-auto mb-3" style="max-width: 400px;">
                    Não foram encontrados registros para o termo ou filtro de humor selecionado.
                </p>
                <a asp-action="Index" class="btn btn-outline-dark rounded-pill px-4">Limpar Filtros</a>
            }
            else
            {
                <div class="display-3 mb-3">✍️</div>
                <h4 class="fw-semibold text-dark">Seu diário ainda não tem páginas escritas</h4>
                <p class="text-muted mx-auto mb-4" style="max-width: 420px;">
                    Reserve este momento para registrar como foi o seu dia, seus aprendizados ou sentimentos.
                </p>
                <a asp-action="Criar" class="btn btn-relax-primary px-4 shadow-sm">Criar meu primeiro registro</a>
            }
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                var (emoji, textoHumor, badgeCor) = item.NivelHumor switch
                {
                    1 => ("😫", "Muito Difícil", "bg-danger-subtle text-danger border border-danger-subtle"),
                    2 => ("🙁", "Para Baixo", "bg-warning-subtle text-warning-emphasis border border-warning-subtle"),
                    3 => ("😐", "Neutro", "bg-secondary-subtle text-secondary border border-secondary-subtle"),
                    4 => ("🙂", "Bem", "bg-info-subtle text-info-emphasis border border-info-subtle"),
                    5 => ("🤩", "Excelente", "bg-success-subtle text-success border border-success-subtle"),
                    _ => ("😐", "Neutro", "bg-secondary-subtle text-secondary border border-secondary-subtle")
                };

                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border rounded-4 bg-white shadow-sm diary-card p-4 d-flex flex-column">

                        <!-- Cabeçalho do Card: Data e Humor -->
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="text-muted extra-small">
                                📅 @item.DataRegistro.ToString("dd/MM/yyyy")
                            </span>
                            <span class="badge rounded-pill px-2 py-1 extra-small fw-semibold @badgeCor">
                                @emoji @textoHumor
                            </span>
                        </div>

                        <!-- Título -->
                        <h5 class="fw-bold mb-2">
                            <a asp-action="Detalhes" asp-route-id="@item.Id" class="text-dark text-decoration-none">
                                @item.Titulo
                            </a>
                        </h5>

                        <!-- Conteúdo Truncado (3 Linhas) -->
                        <p class="text-secondary small line-clamp-3 mb-4 flex-grow-1 lh-base">
                            @item.Conteudo
                        </p>

                        <!-- Rodapé: Ações -->
                        <div class="pt-3 border-top d-flex justify-content-between align-items-center mt-auto">
                            <a asp-action="Detalhes" asp-route-id="@item.Id" class="btn btn-sm btn-link text-decoration-none text-dark fw-semibold ps-0">
                                Ler completo →
                            </a>

                            <div class="d-flex gap-2">
                                <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-sm btn-light border rounded-pill px-3">
                                    Editar
                                </a>
                                <form asp-action="Excluir" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Tem certeza que deseja apagar esta anotação?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-light border text-danger rounded-pill px-3" title="Excluir">
                                        ✕
                                    </button>
                                </form>
                            </div>
                        </div>

                    </div>
                </div>
            }
        </div>
    }
</div>