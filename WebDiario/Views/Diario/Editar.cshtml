@model WebDiario.Models.EntradaDiario

@{
    ViewData["Title"] = "Editar Registro";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            
            <a asp-action="Index" class="btn btn-link text-muted text-decoration-none mb-3 ps-0">
                ← Voltar para as memórias
            </a>

            <div class="card border rounded-4 shadow-sm bg-white p-4 p-md-5">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h2 class="fw-bold text-dark mb-1">Editar Memória</h2>
                        <p class="text-muted small mb-0">Atualize as informações do seu registro.</p>
                    </div>
                    <span class="badge bg-light text-secondary border px-3 py-2 rounded-pill">Modo Edição</span>
                </div>

                <form asp-action="Editar" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="Titulo" class="form-label fw-semibold text-secondary small text-uppercase">Título</label>
                        <input asp-for="Titulo" class="form-control form-control-lg rounded-3 border-light-subtle" />
                        <span asp-validation-for="Titulo" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="DataCriacao" class="form-label fw-semibold text-secondary small text-uppercase">Data</label>
                            <input asp-for="DataCriacao" type="date" class="form-control rounded-3 border-light-subtle" />
                            <span asp-validation-for="DataCriacao" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Humor" class="form-label fw-semibold text-secondary small text-uppercase">Sentimento</label>
                            <select asp-for="Humor" class="form-select rounded-3 border-light-subtle">
                                <option value="😊 Feliz / Realizado">😊 Feliz / Realizado</option>
                                <option value="🚀 Produtivo / Focado">🚀 Produtivo / Focado</option>
                                <option value="🤔 Reflexivo / Calmo">🤔 Reflexivo / Calmo</option>
                                <option value="😴 Cansado / Relaxando">😴 Cansado / Relaxando</option>
                                <option value="⚡ Ansioso / Preocupado">⚡ Ansioso / Preocupado</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Conteudo" class="form-label fw-semibold text-secondary small text-uppercase">Conteúdo</label>
                        <textarea asp-for="Conteudo" rows="9" class="form-control rounded-3 border-light-subtle p-3"></textarea>
                        <span asp-validation-for="Conteudo" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end align-items-center gap-3 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light rounded-pill px-4">Cancelar</a>
                        <button type="submit" class="btn btn-dark rounded-pill px-5 shadow-sm">Salvar Alterações</button>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>