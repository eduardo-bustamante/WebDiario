@model WebDiario.Models.EntradaDiario

@{
    ViewData["Title"] = Model.Titulo;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            
            <!-- Barra de Ações Superior -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <a asp-action="Index" class="btn btn-link text-muted text-decoration-none ps-0">
                    ← Voltar à lista
                </a>
                <div class="d-flex gap-2">
                    <a asp-action="Editar" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                        Editar
                    </a>
                    <a asp-action="Excluir" asp-route-id="@Model.Id" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                        Excluir
                    </a>
                </div>
            </div>

            <!-- Card de Leitura Imersiva -->
            <article class="card border rounded-4 shadow-sm bg-white p-4 p-md-5">
                <!-- Metadados -->
                <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                    <span class="badge bg-light text-secondary border rounded-pill px-3 py-2 fw-normal">
                        📅 @Model.DataCriacao.ToString("dd 'de' MMMM 'de' yyyy")
                    </span>
                    @if (!string.IsNullOrEmpty(Model.Humor))
                    {
                        <span class="badge bg-secondary-subtle text-secondary-emphasis rounded-pill px-3 py-2">
                            @Model.Humor
                        </span>
                    }
                </div>

                <!-- Título -->
                <h1 class="display-6 fw-bold text-dark mb-4 lh-sm">
                    @Model.Titulo
                </h1>

                <hr class="text-secondary opacity-25 my-4" />

                <!-- Corpo do Texto Formatado com Quebras -->
                <div class="entry-content text-dark lh-lg" style="font-size: 1.12rem; white-space: pre-line; word-break: break-word;">
                    @Model.Conteudo
                </div>
            </article>

        </div>
    </div>
</div>