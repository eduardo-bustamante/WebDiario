@model WebDiario.Models.Diario

@{
    ViewData["Title"] = Model.Titulo;

    var (emoji, textoHumor, badgeCor) = Model.NivelHumor switch
    {
        1 => ("😫", "Muito Difícil", "bg-danger-subtle text-danger border border-danger-subtle"),
        2 => ("🙁", "Para Baixo", "bg-warning-subtle text-warning-emphasis border border-warning-subtle"),
        3 => ("😐", "Neutro", "bg-secondary-subtle text-secondary border border-secondary-subtle"),
        4 => ("🙂", "Bem", "bg-info-subtle text-info-emphasis border border-info-subtle"),
        5 => ("🤩", "Excelente", "bg-success-subtle text-success border border-success-subtle"),
        _ => ("😐", "Neutro", "bg-secondary-subtle text-secondary border border-secondary-subtle")
    };
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <!-- Barra Superior com Ações -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <a asp-action="Index" class="btn btn-link text-muted text-decoration-none ps-0">
                    ← Voltar para o diário
                </a>
                <div class="d-flex gap-2">
                    <a asp-action="Editar" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                        Editar
                    </a>
                    <form asp-action="Excluir" asp-route-id="@Model.Id" method="post" class="d-inline" onsubmit="return confirm('Tem certeza que deseja remover esta anotação?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                            Excluir
                        </button>
                    </form>
                </div>
            </div>

            <!-- Card Principal de Leitura -->
            <div class="card border rounded-4 shadow-sm bg-white p-4 p-md-5">

                <!-- Data e Nível de Humor -->
                <div class="d-flex flex-wrap justify-content-between align-items-center pb-3 mb-4 border-bottom gap-2">
                    <div>
                        <span class="text-secondary small fw-semibold text-uppercase d-block">Data do Registro</span>
                        <span class="text-dark fw-bold fs-6">📅 @Model.DataRegistro.ToString("dd 'de' MMMM 'de' yyyy")</span>
                    </div>

                    <span class="badge rounded-pill px-3 py-2 fw-semibold fs-6 @badgeCor">
                        @emoji @textoHumor (Nível @Model.NivelHumor)
                    </span>
                </div>

                <!-- Título -->
                <h1 class="h2 fw-bold text-dark mb-4">@Model.Titulo</h1>

                <!-- Conteúdo com Quebra de Linha Preservada -->
                <div class="text-dark fs-6 lh-lg mb-4" style="white-space: pre-line; word-break: break-word;">
                    @Model.Conteudo
                </div>

                <!-- Informação de Rodapé -->
                <div class="pt-3 border-top text-muted extra-small text-end">
                    Criado originalmente em @Model.DataCriacao.ToString("dd/MM/yyyy 'às' HH:mm")
                </div>

            </div>

        </div>
    </div>
</div>